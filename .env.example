# Copy to .env for local development. `shopify app dev` sets the Shopify
# variables itself; DATABASE_URL must point at a PostgreSQL database.
DATABASE_URL=postgresql://app:app@localhost:5432/app

# Path to a MaxMind GeoLite2-City or GeoIP2-City .mmdb file. Without it the
# Country Blocker cannot locate visitors and lets everyone through.
GEOIP_CITY_DB=

# Optional: GeoLite2-ASN (network and organization) and GeoIP2 Anonymous IP
# (VPN/proxy/hosting flags) databases.
GEOIP_ASN_DB=
GEOIP_ANON_DB=

# Set to "off" to skip downloading the Tor exit list.
TOR_EXIT_LIST=

# Billing: skip the plan gate and charges locally (never in production).
BILLING_DISABLED=true
# Use test charges in production too (for review stores).
# BILLING_TEST=true

# Email over SMTP (Contact Us, cancelled-order notices, weekly summary).
# Locally, Mailpit from docker-compose.dev.yml catches every email at
# http://localhost:8025. In production use your provider, e.g.
# smtps://user:password@smtp.example.com:465
SMTP_URL=smtp://localhost:1025
# MAIL_FROM="Super Visitor Guard <no-reply@example.com>"
# SUPPORT_EMAIL=support@example.com
# Days of visitor logs to keep (minimum 7).
# VISIT_RETENTION_DAYS=90
