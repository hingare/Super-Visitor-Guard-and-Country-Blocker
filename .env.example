# Copy to .env for local development. `shopify app dev` sets the Shopify
# variables itself; DATABASE_URL must point at a PostgreSQL database.
DATABASE_URL=postgresql://app:app@localhost:5432/app

# Path to a MaxMind GeoLite2-City or GeoIP2-City .mmdb file. Without it the
# Country Blocker cannot locate visitors and lets everyone through.
GEOIP_CITY_DB=

# Optional: GeoLite2-ASN (network and organization) and GeoIP2 Anonymous IP
# (VPN/proxy/hosting flags) databases.
GEOIP_ASN_DB=
GEOIP_ANON_DB=

# Set to "off" to skip downloading the Tor exit list.
TOR_EXIT_LIST=
